{
  "title": "Prepare and verify a release artifact",
  "tasks": [
    {
      "id": "runtime",
      "title": "Inspect the Python runtime",
      "capability": "terminal.python_version"
    },
    {
      "id": "write",
      "title": "Write the release artifact",
      "capability": "files.write",
      "parameters": {"path": "release/checklist.txt", "content": "Runtime checked. Artifact verified.\n"}
    },
    {
      "id": "verify",
      "title": "Verify the release artifact",
      "capability": "files.inspect",
      "parameters": {"path": "release/checklist.txt", "expected": "Runtime checked. Artifact verified.\n"},
      "depends_on": ["runtime", "write"]
    }
  ]
}
